# LLM API Keys (at least one required; fallback chain: Grok → Gemini → OpenRouter)
GROK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults shown)
GROK_MODEL=grok-2-1212
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/auto

# Optional: used as HTTP-Referer header for OpenRouter
OPENROUTER_REFERER=https://your-app.vercel.app
